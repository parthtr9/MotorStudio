{
  "$defs": {
    "Actuator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rating": {
          "$ref": "#/$defs/ActuatorRating"
        },
        "profile": {
          "$ref": "#/$defs/ProfileRef"
        }
      },
      "required": [
        "name",
        "rating",
        "profile"
      ],
      "title": "Actuator",
      "type": "object"
    },
    "ActuatorRating": {
      "additionalProperties": false,
      "description": "Datasheet ratings for one motor model. Fields not confirmed against a\nmanual or bench measurement must be listed in `unverified`.",
      "properties": {
        "family": {
          "$ref": "#/$defs/Family"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "continuous_torque_nm": {
          "exclusiveMinimum": 0,
          "title": "Continuous Torque Nm",
          "type": "number"
        },
        "peak_torque_nm": {
          "exclusiveMinimum": 0,
          "title": "Peak Torque Nm",
          "type": "number"
        },
        "max_velocity_rad_s": {
          "exclusiveMinimum": 0,
          "title": "Max Velocity Rad S",
          "type": "number"
        },
        "continuous_current_a": {
          "exclusiveMinimum": 0,
          "title": "Continuous Current A",
          "type": "number"
        },
        "peak_current_a": {
          "exclusiveMinimum": 0,
          "title": "Peak Current A",
          "type": "number"
        },
        "torque_constant_nm_per_a": {
          "exclusiveMinimum": 0,
          "title": "Torque Constant Nm Per A",
          "type": "number"
        },
        "thermal_time_constant_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermal Time Constant S"
        },
        "max_winding_temp_degc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Winding Temp Degc"
        },
        "gear_ratio": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Gear Ratio",
          "type": "number"
        },
        "unverified": {
          "items": {
            "type": "string"
          },
          "title": "Unverified",
          "type": "array"
        }
      },
      "required": [
        "family",
        "model",
        "continuous_torque_nm",
        "peak_torque_nm",
        "max_velocity_rad_s",
        "continuous_current_a",
        "peak_current_a",
        "torque_constant_nm_per_a"
      ],
      "title": "ActuatorRating",
      "type": "object"
    },
    "BusConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "interface": {
          "enum": [
            "socketcan",
            "slcan",
            "pcan",
            "gs_usb",
            "replay",
            "vcan"
          ],
          "title": "Interface",
          "type": "string"
        },
        "bitrate": {
          "default": 1000000,
          "exclusiveMinimum": 0,
          "title": "Bitrate",
          "type": "integer"
        },
        "supply_voltage_v": {
          "exclusiveMinimum": 0,
          "title": "Supply Voltage V",
          "type": "number"
        },
        "supply_current_limit_a": {
          "exclusiveMinimum": 0,
          "title": "Supply Current Limit A",
          "type": "number"
        },
        "regen_current_limit_a": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regen Current Limit A"
        }
      },
      "required": [
        "name",
        "interface",
        "supply_voltage_v",
        "supply_current_limit_a"
      ],
      "title": "BusConfig",
      "type": "object"
    },
    "ControlMode": {
      "enum": [
        "mit",
        "servo",
        "position",
        "velocity",
        "torque"
      ],
      "title": "ControlMode",
      "type": "string"
    },
    "Family": {
      "enum": [
        "cubemars",
        "robstride",
        "damiao",
        "myactuator",
        "hexfellow",
        "hightorque"
      ],
      "title": "Family",
      "type": "string"
    },
    "Joint": {
      "additionalProperties": false,
      "description": "Maps a URDF joint name to an actuator, bus and CAN ID, with optional\nuser-specified caps tighter than the actuator rating.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "urdf_joint": {
          "title": "Urdf Joint",
          "type": "string"
        },
        "actuator": {
          "title": "Actuator",
          "type": "string"
        },
        "bus": {
          "title": "Bus",
          "type": "string"
        },
        "can_id": {
          "maximum": 536870911,
          "minimum": 0,
          "title": "Can Id",
          "type": "integer"
        },
        "control_mode": {
          "$ref": "#/$defs/ControlMode"
        },
        "transmission_ratio": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Transmission Ratio",
          "type": "number"
        },
        "limits": {
          "$ref": "#/$defs/JointLimitOverride"
        }
      },
      "required": [
        "name",
        "urdf_joint",
        "actuator",
        "bus",
        "can_id",
        "control_mode"
      ],
      "title": "Joint",
      "type": "object"
    },
    "JointLimitOverride": {
      "additionalProperties": false,
      "description": "User-specified cap. Effective limit compiler takes the min of this,\nthe actuator rating, the URDF joint limit, and the profile scale.",
      "properties": {
        "max_torque_nm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Torque Nm"
        },
        "max_velocity_rad_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Velocity Rad S"
        },
        "max_position_rad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Position Rad"
        },
        "min_position_rad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Position Rad"
        }
      },
      "title": "JointLimitOverride",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "description": "Named pose for the hold-torque check: joint name -> position (rad).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "joint_positions": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Joint Positions",
          "type": "object"
        }
      },
      "required": [
        "name",
        "joint_positions"
      ],
      "title": "Pose",
      "type": "object"
    },
    "ProfileRef": {
      "additionalProperties": false,
      "description": "Points at profiles/<family>/<model>_<fw>.yaml.",
      "properties": {
        "family": {
          "$ref": "#/$defs/Family"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "firmware": {
          "title": "Firmware",
          "type": "string"
        }
      },
      "required": [
        "family",
        "model",
        "firmware"
      ],
      "title": "ProfileRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Root of robot_hw.yaml.",
  "properties": {
    "schema_version": {
      "const": 0,
      "default": 0,
      "title": "Schema Version",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "urdf_path": {
      "title": "Urdf Path",
      "type": "string"
    },
    "buses": {
      "items": {
        "$ref": "#/$defs/BusConfig"
      },
      "title": "Buses",
      "type": "array"
    },
    "actuators": {
      "items": {
        "$ref": "#/$defs/Actuator"
      },
      "title": "Actuators",
      "type": "array"
    },
    "joints": {
      "items": {
        "$ref": "#/$defs/Joint"
      },
      "title": "Joints",
      "type": "array"
    },
    "poses": {
      "items": {
        "$ref": "#/$defs/Pose"
      },
      "title": "Poses",
      "type": "array"
    }
  },
  "required": [
    "name",
    "urdf_path",
    "buses",
    "actuators",
    "joints"
  ],
  "title": "RobotSpec",
  "type": "object"
}
